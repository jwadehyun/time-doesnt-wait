    <!-- Welcome -->
    <string name="welcome_step">%1$d/%2$d 단계</string>
    <string name="welcome_body">매시 정각에 질문 하나: 방금 뭐 했어요? 알림에서 바로 답하세요. 잠금 화면에서도 돼요.</string>
    <string name="welcome_language">언어</string>
    <string name="welcome_start">[ 시작 ]</string>
    <string name="welcome_signin_later">Google·카카오 로그인은 클라우드 동기화와 함께 추가돼요. 지금 기록한 내용은 이 휴대폰에 저장되고 나중에 동기화돼요.</string>

    <!-- Permissions -->
    <string name="perm_title">권한 설정</string>
    <string name="perm_intro">알림이 제시간에 오고, 잠금을 풀지 않고도 답할 수 있게 해 줘요.</string>
    <string name="perm_notifications">알림</string>
    <string name="perm_notifications_desc">매시간 체크인 알림을 보여 주려면 필요해요.</string>
    <string name="perm_alarms">알람 및 리마인더</string>
    <string name="perm_alarms_desc">정각에 정확히 알림이 오게 해요. 없으면 최대 10분 정도 늦을 수 있어요.</string>
    <string name="perm_battery">배터리 최적화</string>
    <string name="perm_battery_desc">밤사이 앱이 잠들어 체크인을 건너뛰지 않게 해요.</string>
    <string name="perm_battery_samsung">삼성 휴대폰은 배터리 설정에서 “절대 절전 상태로 전환하지 않을 앱”에도 추가해 주세요.</string>
    <string name="perm_battery_xiaomi">샤오미 휴대폰은 자동 시작을 켜고 배터리 절약을 “제한 없음”으로 설정해 주세요.</string>
    <string name="perm_lock">잠금 화면 답장</string>
    <string name="perm_lock_desc">잠금을 풀지 않고 답하려면 잠금 화면에 알림이 보이도록 설정해야 해요.</string>
