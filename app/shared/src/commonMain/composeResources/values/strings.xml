    <!-- Welcome -->
    <string name="welcome_step">STEP %1$d/%2$d</string>
    <string name="welcome_body">Every hour on the hour, you get one question: what did you just do? Answer straight from the notification, even on the lock screen.</string>
    <string name="welcome_language">LANGUAGE</string>
    <string name="welcome_start">[ START ]</string>
    <string name="welcome_signin_later">Google and Kakao sign-in arrive with cloud sync. Everything you log now stays on this phone and syncs later.</string>

    <!-- Permissions -->
    <string name="perm_title">PERMISSIONS</string>
    <string name="perm_intro">These keep check-ins on time and let you reply without unlocking.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_desc">Needed to show the hourly check-in.</string>
    <string name="perm_alarms">Alarms &amp; reminders</string>
    <string name="perm_alarms_desc">Lets check-ins fire exactly on the hour. Without it they can run up to ~10 min late.</string>
    <string name="perm_battery">Battery optimization</string>
    <string name="perm_battery_desc">Stops the phone from putting the app to sleep and skipping check-ins overnight.</string>
    <string name="perm_battery_samsung">On Samsung, also add the app to “Never sleeping apps” in Battery settings.</string>
    <string name="perm_battery_xiaomi">On Xiaomi, also turn on Autostart and set Battery saver to “No restrictions”.</string>
    <string name="perm_lock">Lock-screen replies</string>
    <string name="perm_lock_desc">Your lock screen must show notifications for you to reply without unlocking.</string>
